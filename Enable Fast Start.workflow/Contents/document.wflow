				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/bash

# Find ffmpeg — checks Homebrew paths for Intel and Apple Silicon
FFMPEG=""
for candidate in /opt/homebrew/bin/ffmpeg /usr/local/bin/ffmpeg; do
    if [ -x "$candidate" ]; then
        FFMPEG="$candidate"
        break
    fi
done

if [ -z "$FFMPEG" ]; then
    osascript -e 'display alert "faststart" message "ffmpeg not found. Install it with: brew install ffmpeg"'
    exit 1
fi

for INPUT in "$@"; do
    DIR=$(dirname "$INPUT")
    FILENAME=$(basename "$INPUT")
    TMP="$DIR/.faststart_tmp_$$_$FILENAME"

    "$FFMPEG" -i "$INPUT" -c copy -movflags +faststart "$TMP" -y 2&gt;/dev/null

    if [ $? -eq 0 ]; then
        mv "$TMP" "$INPUT"
    else
        rm -f "$TMP"
        osascript -e "display alert \"faststart failed\" message \"Could not process: $FILENAME\""
        exit 1
    fi
done
</string>
