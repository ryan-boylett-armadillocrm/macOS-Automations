				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>for img in "$@"
do
  # Skip SVG files
  case "$img" in
    *.svg|*.SVG)
      echo "Skipping already SVG: $img"
      continue
      ;;
  esac

  dir=$(dirname "$img")
  filename=$(basename "$img")
  name="${filename%.*}"

  pbm="/tmp/$name.pbm"
  svg="$dir/$name.svg"

  echo "Processing: $img"

  # Convert image → white background → grayscale → threshold
  /opt/homebrew/bin/magick "$img" \
    -background white -alpha remove \
    -colorspace Gray -threshold 60% \
    "$pbm"

  if [ ! -f "$pbm" ]; then
    echo "Failed to create PBM for $img"
    continue
  fi

  # Trace to SVG
  /opt/homebrew/bin/potrace "$pbm" -s -o "$svg"

  if [ -f "$svg" ]; then
    echo "Created: $svg"

    # Remove any explicit white fill (backgrounds, if present)
    sed -i '' 's/fill="#ffffff"//Ig' "$svg"

    # Replace black fill with currentColor
    sed -i '' 's/fill="#000000"/fill="currentColor"/Ig' "$svg"

    # Optional: ensure SVG has no hardcoded background
    sed -i '' 's/style="[^"]*background[^"]*"//Ig' "$svg"
  else
    echo "Potrace failed on $img"
  fi

  # Always clean up
  rm "$pbm"
done</string>
