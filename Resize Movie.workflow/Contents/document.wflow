				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/bash

# Path to ffmpeg (adjust if needed)
FFMPEG="/usr/local/bin/ffmpeg"
[ ! -x "$FFMPEG" ] &amp;&amp; FFMPEG="/opt/homebrew/bin/ffmpeg"

if [ ! -x "$FFMPEG" ]; then
  echo "ffmpeg not found. Please install ffmpeg."
  exit 1
fi

TARGET_WIDTH=650

for INPUT in "$@"; do
  # Skip non-files
  [ ! -f "$INPUT" ] &amp;&amp; continue

  DIR="$(dirname "$INPUT")"
  BASENAME="$(basename "$INPUT")"
  NAME="${BASENAME%.*}"

  OUTPUT="$DIR/${NAME}.${TARGET_WIDTH}w.mp4"

  "$FFMPEG" -y \
    -i "$INPUT" \
    -map 0:v:0 -map 0:a? \
    -vf "scale=${TARGET_WIDTH}:-2" \
    -c:v libx264 \
    -preset slow \
    -crf 23 \
    -pix_fmt yuv420p \
    -profile:v high \
    -level 4.2 \
    -movflags +faststart \
    -c:a aac \
    -b:a 160k \
    "$OUTPUT"
done</string>
					<key>CheckedForUserDefaultShell</key>
