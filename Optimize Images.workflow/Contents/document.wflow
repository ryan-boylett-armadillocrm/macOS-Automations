				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/usr/bin/env bash

# ---- Configuration ----
PNGQUANT_FLAGS="--quality=65-80 --speed=1"
OPTIPNG_FLAGS="-o7"
JPEGOPTIM_FLAGS="--strip-all --max=85"
WEBP_LOSSY_QUALITY=85

GIF_MAX_MB=2.5
GIF_MAX_PASSES=3
GIF_LOSSY_START=30
GIF_LOSSY_MAX=80
GIF_LOSSY_STEP=10

# ---- GIF helpers ----
_gif_file_bytes()  { stat -f%z "$1"; }
_gif_max_bytes()   { awk "BEGIN { printf \"%d\", ${GIF_MAX_MB} * 1024 * 1024 }"; }
_gif_under_limit() { [[ $(_gif_file_bytes "$1") -le $(_gif_max_bytes) ]]; }

_gif_frame_count() {
  /opt/homebrew/bin/gifsicle -I "$1" 2&gt;/dev/null | grep -c "image #" || true
}

_gif_delay_cs() {
  local raw
  raw=$(/opt/homebrew/bin/gifsicle -I "$1" 2&gt;/dev/null \
    | grep -m1 "delay" \
    | grep -oE '[0-9]+\.[0-9]+' \
    || true)
  [[ -n "$raw" ]] &amp;&amp; awk "BEGIN { printf \"%d\", ${raw} * 100 }" || echo "4"
}

_gif_halve_frames() {
  local input="$1" output="$2"
  local unopt frame_count delay_cs new_delay select_args=() i

  unopt=$(mktemp /tmp/gif-unopt-XXXXXX)
  /opt/homebrew/bin/gifsicle --unoptimize "$input" -o "$unopt" &gt;/dev/null 2&gt;&amp;1

  frame_count=$(_gif_frame_count "$unopt")
  if [[ "$frame_count" -le 2 ]]; then
    mv "$unopt" "$output"
    return
  fi

  delay_cs=$(_gif_delay_cs "$unopt")
  [[ -z "$delay_cs" || "$delay_cs" -eq 0 ]] &amp;&amp; delay_cs=4
  new_delay=$(( delay_cs * 2 ))

  for (( i=0; i&lt;frame_count; i+=2 )); do
    select_args+=( "#${i}" )
  done

  last=$(( frame_count - 1 ))
  (( last % 2 != 0 )) &amp;&amp; select_args+=( "#${last}" )

  /opt/homebrew/bin/gifsicle -O2 --delay "$new_delay" \
    "$unopt" "${select_args[@]}" \
    -o "$output" &gt;/dev/null 2&gt;&amp;1

  rm -f "$unopt"
}

# ---- Per-file worker ----
optimize_one() {
    local FILE="$1"
    [ -f "$FILE" ] || return

    local filename base EXT EXT_LOWER

    filename=$(basename "$FILE")
    base="${filename%.*}"

    # Skip files ending with _ol, _out, _outlook
    #if [[ "$base" =~ (_ol|_out|_outlook)$ ]]; then
    #    return
    #fi

    EXT="${FILE##*.}"
    EXT_LOWER=$(echo "$EXT" | tr '[:upper:]' '[:lower:]')

    case "$EXT_LOWER" in
        png)
            /opt/homebrew/bin/optipng $OPTIPNG_FLAGS "$FILE" &gt;/dev/null 2&gt;&amp;1
            /opt/homebrew/bin/pngquant $PNGQUANT_FLAGS --ext ".png" --force "$FILE" &gt;/dev/null 2&gt;&amp;1
        ;;

        jpg|jpeg)
            /opt/homebrew/bin/jpegoptim $JPEGOPTIM_FLAGS "$FILE" &gt;/dev/null 2&gt;&amp;1
        ;;

        gif)
            _gif_under_limit "$FILE" &amp;&amp; return

            WORK=$(mktemp -d /tmp/gif-opt-XXXXXX)
            local work="$WORK/work.gif"
            cp "$FILE" "$work"

            local pass=0
            while ! _gif_under_limit "$work" &amp;&amp; [[ $pass -lt $GIF_MAX_PASSES ]]; do
                pass=$(( pass + 1 ))
                tmp="$WORK/pass_${pass}.gif"
                _gif_halve_frames "$work" "$tmp"
                mv "$tmp" "$work"
            done

            if _gif_under_limit "$work"; then
                mv "$work" "$FILE"
            else
                local lossy=$GIF_LOSSY_START
                local lossy_out="$WORK/lossy.gif"

                /opt/homebrew/bin/gifsicle -O3 --lossy="${lossy}" "$work" -o "$lossy_out" &gt;/dev/null 2&gt;&amp;1

                while ! _gif_under_limit "$lossy_out" &amp;&amp; [[ $lossy -lt $GIF_LOSSY_MAX ]]; do
                    lossy=$(( lossy + GIF_LOSSY_STEP ))
                    [[ $lossy -gt $GIF_LOSSY_MAX ]] &amp;&amp; lossy=$GIF_LOSSY_MAX
                    /opt/homebrew/bin/gifsicle -O3 --lossy="${lossy}" "$work" -o "$lossy_out" &gt;/dev/null 2&gt;&amp;1
                done

                mv "$lossy_out" "$FILE"
            fi

            rm -rf "$WORK"
        ;;

        webp)
            local TMP="${FILE%.*}_optimized.webp"
            /opt/homebrew/bin/cwebp -q $WEBP_LOSSY_QUALITY "$FILE" -o "$TMP" &gt;/dev/null 2&gt;&amp;1 &amp;&amp; mv "$TMP" "$FILE"
        ;;
    esac

    true  # pngquant exits 98 when already optimal; ensure worker always returns 0
}

export -f optimize_one
export PNGQUANT_FLAGS OPTIPNG_FLAGS JPEGOPTIM_FLAGS WEBP_LOSSY_QUALITY
export GIF_MAX_MB GIF_MAX_PASSES GIF_LOSSY_START GIF_LOSSY_MAX GIF_LOSSY_STEP
export -f _gif_file_bytes _gif_max_bytes _gif_under_limit _gif_frame_count _gif_delay_cs _gif_halve_frames

# ---- Parallel execution ----
printf '%s\0' "$@" | xargs -0 -n1 -P "$(sysctl -n hw.ncpu)" bash -c 'optimize_one "$@"' _

exit 0  # prevent xargs non-zero exit from triggering Automator's error alert
</string>
