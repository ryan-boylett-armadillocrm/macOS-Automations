				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/usr/bin/env bash
# resize-image.sh
# Resize selected images in-place via a dimension prompt.
# Uses ImageMagick for all formats; preserves animated GIF frames.
#
# Requirements:
#   - ImageMagick  →  brew install imagemagick
#
# Usage (Automator Quick Action):
#   Workflow receives: files or folders in Finder
#   Shell: /bin/bash  ·  Pass input: as arguments
#   Command: /path/to/resize-image.sh "$@"

[[ $# -eq 0 ]] &amp;&amp; exit 0

IM=/opt/homebrew/bin/magick

# ── Default to first image's current dimensions ───────────────────────────────
current_w=$(sips -g pixelWidth  "$1" 2&gt;/dev/null | awk '/pixelWidth/{print $2}')
current_h=$(sips -g pixelHeight "$1" 2&gt;/dev/null | awk '/pixelHeight/{print $2}')
default_dims="${current_w:-1920}x${current_h:-1080}"

# ── Prompt for dimensions ─────────────────────────────────────────────────────
result=$(osascript 2&gt;/dev/null &lt;&lt;ASEOF
  set response to display dialog "Resize to (use 'auto' for one dimension to maintain aspect ratio):" default answer "${default_dims}" buttons {"Cancel", "Resize"} default button "Resize"
  text returned of response
ASEOF
)

# Exit silently on Cancel
[[ $? -ne 0 || -z "$result" ]] &amp;&amp; exit 0

width="${result%%x*}"
height="${result##*x}"

# ── Validate ──────────────────────────────────────────────────────────────────
valid_dim() { [[ "$1" =~ ^[0-9]+$ || "$1" == "auto" ]]; }

if ! valid_dim "$width" || ! valid_dim "$height"; then
  osascript -e 'display alert "Invalid format — use WxH (e.g. 1920x1080) or '\''auto'\'' for one dimension (e.g. 1920xauto)." as warning'
  exit 1
fi

if [[ "$width" == "auto" &amp;&amp; "$height" == "auto" ]]; then
  osascript -e 'display alert "At least one dimension must be a number." as warning'
  exit 1
fi

# ── Build ImageMagick resize geometry ─────────────────────────────────────────
# Both given: exact resize (! suppresses aspect-ratio correction)
# One given:  ImageMagick infers the other proportionally (x600 or 800)
if [[ "$width" == "auto" ]]; then
  dims="x${height}"
elif [[ "$height" == "auto" ]]; then
  dims="${width}"
else
  dims="${width}x${height}!"
fi

# ── Resize each file ──────────────────────────────────────────────────────────
for FILE in "$@"; do
  [[ -f "$FILE" ]] || continue

  ext=$(echo "${FILE##*.}" | tr '[:lower:]' '[:upper:]')
  tmp=$(mktemp /tmp/resize-XXXXXX)

  if [[ "$ext" == "GIF" ]]; then
    # -coalesce expands delta frames to full frames before resizing,
    # -layers optimize re-applies delta encoding afterwards.
    "$IM" "$FILE" -coalesce -resize "$dims" -layers optimize "GIF:${tmp}"
  else
    "$IM" "$FILE" -resize "$dims" "${ext}:${tmp}"
  fi

  if [[ -s "$tmp" ]]; then
    mv "$tmp" "$FILE"
  else
    rm -f "$tmp"
  fi
done
</string>
